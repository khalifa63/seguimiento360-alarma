{
  "config": {
    "default": false,
    "MD001": true,
    "MD010": true,
    "MD042": true,
    "MD045": true,
    "MD056": true
  },
  "ignores": [
    "docs/_archivo/**",
    "node_modules/**",
    "site/**",
    ".npm-cache/**",
    ".mkdocs-deps/**",
    ".venv-docs/**",
    ".tmp-pip/**"
  ]
}
