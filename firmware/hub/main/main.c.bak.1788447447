// MODIFICADO: Se agrega validación de límite al inicio, pero se respeta toda la lógica de pairing existente
static void on_data_recv(const esp_now_recv_info_t *recv_info, const uint8_t *data, int len) {
    // NUEVO: Validar límite de nodos antes de procesar pairing o datos
    esp_now_peer_num_t peer_num;
    esp_now_get_peer_num(&peer_num);
    if (peer_num.total_num >= MAX_ALLOWED_PEERS) {
        ESP_LOGW(TAG, "Límite de nodos alcanzado (%d). Pairing/Datos rechazados.", MAX_ALLOWED_PEERS);
        // Opcional: Aquí podrías enviar un paquete ESP-NOW de respuesta "RECHAZADO" al nodo
        return;
    }

    // =========================================================================
    // AQUÍ VA TU LÓGICA EXISTENTE DE on_data_recv (Canal sync, pairing, etc.)
    // NO MODIFICAR: Sincronización de canales AP/STA, peer broadcast, etc.
    // =========================================================================
    ESP_LOGI(TAG, "Datos recibidos de " MACSTR, MAC2STR(recv_info->src_addr));
    // ... tu código probado ...
}

// MODIFICADO: Se mantiene la lógica original, solo se asegura la actualización de flags
static void wifi_event_handler(void* arg, esp_event_base_t event_base, int32_t event_id, void* event_data) {
    if (event_base == WIFI_EVENT && event_id == WIFI_EVENT_STA_START) {
        // Lógica existente...
    } else if (event_base == WIFI_EVENT && event_id == WIFI_EVENT_STA_DISCONNECTED) {
        xEventGroupSetBits(wifi_event_group, WIFI_FAIL_BIT);
        // Lógica existente de reconexión o sync de canal...
    } else if (event_base == IP_EVENT && event_id == IP_EVENT_STA_GOT_IP) {
        ip_event_got_ip_t* event = (ip_event_got_ip_t*) event_data;
        ESP_LOGI(TAG, "Obtenida IP: " IPSTR, IP2STR(&event->ip_info.ip));
        xEventGroupSetBits(wifi_event_group, WIFI_CONNECTED_BIT);
        // Lógica existente: start_mqtt_client(), etc.
    }
}

