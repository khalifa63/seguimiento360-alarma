// ==========================================
// CONFIGURACIÓN Y DEFINICIONES
// ==========================================
#define MAX_ALLOWED_PEERS 20
#define WIFI_CONNECT_TIMEOUT_MS 15000
#define PORTAL_INACTIVITY_TIMEOUT_MS 60000

// ==========================================
// ESTRUCTURAS DE DATOS (NVS)
// ==========================================
// Estructura antigua (para migración transparente)
typedef struct {
    char ssid[33];
    char password[65];
} wifi_credentials_t;

// NUEVO: Estructura mejorada con soporte Multi-tenant
typedef struct {
    uint8_t version;          // 1 = legacy, 2 = actual
    char ssid[33];
    char password[65];
    char tenant_id[16];       // Default: "0"
    char site_id[32];         // Default: "site0"
} hub_config_t;

// ==========================================
// VARIABLES GLOBALES
// ==========================================
static nvs_handle_t nvs_handle_pairing;
static bool wifi_configured = false;
static httpd_handle_t server = NULL;
static uint8_t router_channel = 0;
static char hub_mac_str[18];

// NUEVO: Máquina de estados del portal
typedef enum {
    PORTAL_STATE_CONFIGURING,
    PORTAL_STATE_TESTING,
    PORTAL_STATE_CONNECTED,
    PORTAL_STATE_FAILED
} portal_state_t;

static portal_state_t current_portal_state = PORTAL_STATE_CONFIGURING;
static hub_config_t active_config = {0};
static uint64_t last_portal_activity = 0;
static bool mqtt_is_connected = false; // Actualizar esta flag desde tu mqtt_event_handler existente

static EventGroupHandle_t wifi_event_group;
#define WIFI_CONNECTED_BIT BIT0
#define WIFI_FAIL_BIT      BIT1

// ==========================================
// FUNCIONES DE UTILIDAD Y NVS
// ==========================================
// NUEVO: Decodificador URL básico para el formulario
static void url_decode(char *dst, const char *src, size_t dst_size) {
    char a, b;
    size_t j = 0;
    for (size_t i = 0; src[i] && j < dst_size - 1; i++, j++) {
        if (src[i] == '+') dst[j] = ' ';
        else if (src[i] == '%' && src[i+1] && src[i+2]) {
            a = src[i+1]; b = src[i+2];
            dst[j] = ((a <= '9' ? a - '0' : (a & 0x7) + 9) << 4) | (b <= '9' ? b - '0' : (b & 0x7) + 9);
            i += 2;
        } else {
            dst[j] = src[i];
        }
    }
    dst[j] = '\0';
}

// NUEVO: Extracción de parámetros del formulario POST
static void get_form_param(const char *buf, const char *name, char *out, size_t out_size) {
    char search[64];
    snprintf(search, sizeof(search), "%s=", name);
    const char *start = strstr(buf, search);
    if (start) {
        start += strlen(search);
        const char *end = strchr(start, '&');
        size_t len = end ? (size_t)(end - start) : strlen(start);
        if (len >= out_size) len = out_size - 1;
        
        char raw[out_size];
        strncpy(raw, start, len);
        raw[len] = '\0';
        url_decode(out, raw, out_size);
    }
}

// MODIFICADO: Carga de configuración con migración automática
static esp_err_t load_config() {
    esp_err_t err = nvs_open("pairing", NVS_READWRITE, &nvs_handle_pairing);
    if (err != ESP_OK) return err;

    size_t required_size = sizeof(hub_config_t);
    err = nvs_get_blob(nvs_handle_pairing, "hub_config", &active_config, &required_size);
    
    if (err == ESP_ERR_NVS_NOT_FOUND) {
        // Intentar migrar desde la estructura antigua "wifi_creds"
        wifi_credentials_t old_creds;
        size_t old_size = sizeof(wifi_credentials_t);
        if (nvs_get_blob(nvs_handle_pairing, "wifi_creds", &old_creds, &old_size) == ESP_OK) {
            ESP_LOGI(TAG, "Migrando configuración legacy a multi-tenant...");
            active_config.version = 2;
            strncpy(active_config.ssid, old_creds.ssid, sizeof(active_config.ssid));
            strncpy(active_config.password, old_creds.password, sizeof(active_config.password));
            strcpy(active_config.tenant_id, "0");
            strcpy(active_config.site_id, "site0");
            nvs_set_blob(nvs_handle_pairing, "hub_config", &active_config, sizeof(hub_config_t));
            nvs_commit(nvs_handle_pairing);
            nvs_erase_key(nvs_handle_pairing, "wifi_creds"); // Limpieza
        } else {
            // Configuración de fábrica por defecto
            active_config.version = 2;
            strcpy(active_config.tenant_id, "0");
            strcpy(active_config.site_id, "site0");
        }
    } else if (err == ESP_OK && active_config.version == 1) {
        // Parche de seguridad si se detecta versión 1 incompleta
        strcpy(active_config.tenant_id, "0");
        strcpy(active_config.site_id, "site0");
        active_config.version = 2;
        nvs_set_blob(nvs_handle_pairing, "hub_config", &active_config, sizeof(hub_config_t));
        nvs_commit(nvs_handle_pairing);
    }
    return ESP_OK;
}

static esp_err_t save_config() {
    active_config.version = 2;
    return nvs_set_blob(nvs_handle_pairing, "hub_config", &active_config, sizeof(hub_config_t)) || nvs_commit(nvs_handle_pairing);
}

// NUEVO: Helper para construir tópicos MQTT dinámicos
void get_mqtt_topic(char *out_buffer, size_t buffer_size, const char *suffix) {
    snprintf(out_buffer, buffer_size, "seguimiento360/tenant/%s/site/%s/hub/%s/%s", 
             active_config.tenant_id, active_config.site_id, hub_mac_str, suffix);
}

