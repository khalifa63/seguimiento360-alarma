# Configuración básica
allow_anonymous true
password_file /mosquitto/config/passwd

# Puerto MQTT estándar (conexiones locales)
listener 1883
protocol mqtt

# Puerto MQTT con SSL/TLS
listener 8883
protocol mqtt

# Puerto WebSockets (para ESP32 remotos vía Cloudflare)
listener 8083
protocol websockets
socket_domain ipv4

# Puerto WebSockets alternativo (ya estaba configurado)
listener 9001
protocol websockets
