# ============================================
# Seguimiento 360 - Archivo .gitignore
# ============================================

# Variables de entorno (Secretos y Tokens)
.env
.env.local
.env.production

# Node-RED - Archivos con credenciales
nodered/data/settings.js
nodered/data/flows_cred.json
nodered/data/.config.json
nodered/data/.sessions.json
nodered/data/.config.json.backup*

# ESP-IDF Build Directories (NO subir)
**/build/
**/sdkconfig
**/sdkconfig.old
**/sdkconfig.ci.*

# Backups de Base de Datos
*.sql
*.sql.gz
backups/
backup_*.tar.gz

# Logs de producción
*.log
mosquitto/log/

# Archivos temporales del sistema
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE y Editores
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Node modules (si se agregan fuera de contenedores)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker volumes montados localmente (si aplica)
influxdb/data/
grafana/data/
uptime-kuma/data/
gotify-data/
mosquitto/data/

# Certificados SSL (si se generan localmente)
*.pem
# Paquetes de respaldo de claves. No deberian estar aqui, pero si alguien
# deja uno en el arbol de trabajo es mejor que git lo ignore a que lo suba.
*.gpg
ota-claves*
*.key
*.crt
*.cert

# Archivos de configuración con datos reales
traccar/traccar.xml.local
mosquitto/config/passwd

# Documentación generada
.docs-work/
site/
dify-kb/

# Herramientas locales de validación
.npm-cache/
.mkdocs-deps/
.venv-docs/
.tmp-pip/

# Configuración real de Node-RED (la plantilla sí se versiona)
backend/nodered/settings.js
nodered/data/settings.js

# Firmware: secretos y artefactos
firmware/**/secrets.h
firmware/**/backups/
*.bak
*.bak.*

# Previews temporales de Office
.dsh-office-*/

# Plantillas probadas (contienen credenciales de ejemplo)
plantillas-probadas/

# Volcados de flash y respaldos de NVS: contienen credenciales del dispositivo.
# Nunca se versionan. Los respaldos viven en ~/backups-flash/ del servidor.
**/backups/flash/
*.sha256

# Configuracion local de compilacion.
# sdkconfig y sdkconfig.old los genera idf.py y son de cada maquina.
# sdkconfig.defaults NO: es configuracion del producto (target, particiones,
# PSRAM, WSS, OTA) y debe estar en el repo. Estaba ignorado, asi que el CI
# compilaba con los valores por defecto y validaba algo distinto de lo que
# se flashea.
**/sdkconfig
**/sdkconfig.old

# Binarios generados por las pruebas de firmware en el PC
tests/firmware/test_claim_code
tests/firmware/*.o

# Salida generada de los manuales (HTML y PDF). Se regenera con
# scripts/manuales/generar.sh desde los .md, que si se versionan.
docs/manuales/salida/
vapid.json
service-account.json
service-account*.json
flows_cred.json
*.bak-*
.env.*
*.backup-*
