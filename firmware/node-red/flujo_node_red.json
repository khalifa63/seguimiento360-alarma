// ============================================================================
// CARGAR ESTADO DE ACTIVACIÓN / ESTADO LOCAL
// ============================================================================

bool loadActivatedState() {

  prefs.begin(
    NVS_NAMESPACE,
    true
  );

  const bool activated =
    prefs.getBool(
      KEY_ACTIVATED,
      false
    );

  String storedState =
    prefs.getString(
      KEY_DEVICE_STATE,
      STATE_DISARMED
    );

  prefs.end();

  storedState.trim();
  storedState.toUpperCase();

  if (
    storedState != STATE_WAREHOUSE &&
    storedState != STATE_DISARMED &&
    storedState != STATE_ARMED &&
    storedState != STATE_INACTIVE
  ) {

    storedState =
      STATE_DISARMED;
  }

  storedState.toCharArray(
    currentDeviceState,
    sizeof(currentDeviceState)
  );

  Serial.printf(
    "[STATE] Local=%s | activated=%s\n",
    currentDeviceState,
    activated ? "true" : "false"
  );

  return activated;
}

