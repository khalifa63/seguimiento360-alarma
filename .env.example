# ============================================
# Seguimiento 360 - Variables de Entorno
# ============================================
#
# INSTRUCCIONES:
# 1. Copia este archivo como '.env' en la raíz del proyecto
# 2. Reemplaza TODOS los valores con tus credenciales reales
# 3. NUNCA subas el archivo .env real al repositorio
#
# Generar valores seguros:
#   - Token Cloudflare: Desde el dashboard de Cloudflare Zero Trust
#   - JWT Secret: openssl rand -hex 32
#   - Contraseñas: openssl rand -base64 24
# ============================================

# ============================================
# CLOUDFLARE TUNNEL
# ============================================
# Obtén este token desde: https://one.dash.cloudflare.com/ -> Zero Trust -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=tu_token_de_cloudflare_aqui

# ============================================
# POSTGRESQL
# ============================================
# Contraseña del usuario 'admin' o 'nodered_app' en PostgreSQL
POSTGRES_PASSWORD=tu_contraseña_segura_de_postgresql_aqui

# ============================================
# INFLUXDB (v2.7)
# ============================================
INFLUXDB_ADMIN_PASSWORD=tu_contraseña_segura_de_influxdb_aqui
INFLUXDB_INIT_ORG=seguimiento360
INFLUXDB_INIT_BUCKET=telemetria

# ============================================
# GRAFANA
# ============================================
GRAFANA_ADMIN_PASSWORD=tu_contraseña_segura_de_grafana_aqui

# ============================================
# NODE-RED - JWT
# ============================================
# Mínimo 32 caracteres. Generar con: openssl rand -hex 32
JWT_SECRET=tu_jwt_secret_de_32_caracteres_aqui

# ============================================
# GOTIFY
# ============================================
GOTIFY_ADMIN_PASSWORD=tu_contraseña_segura_de_gotify_aqui

# MQTT - usuario de Node-RED en el broker Mosquitto
MQTT_NODERED_USER=nodered
MQTT_NODERED_PASSWORD=tu_password_del_usuario_nodered
