// ============================================================================
// MODEM TRANSACTION MANAGER
// ============================================================================

enum ModemTransactionState {
  MODEM_TX_IDLE = 0,
  MODEM_TX_GNSS,
  MODEM_TX_HTTP_PREPARE,
  MODEM_TX_HTTP_ACTION,
  MODEM_TX_HTTP_READ,
  MODEM_TX_RECOVERY
};

volatile ModemTransactionState modemTxState =
  MODEM_TX_IDLE;

portMUX_TYPE modemTxMux =
  portMUX_INITIALIZER_UNLOCKED;

int cachedSignal =
  -1;

int cachedBattery =
  -1;

bool beginModemTransaction(
  ModemTransactionState requested,
  const char* owner
) {

  bool granted =
    false;

  portENTER_CRITICAL(
    &modemTxMux
  );

  if (
    modemTxState ==
    MODEM_TX_IDLE
  ) {

    modemTxState =
      requested;

    granted =
      true;
  }

  portEXIT_CRITICAL(
    &modemTxMux
  );

  Serial.printf(
    granted
      ? "[MODEM TX] LOCK owner=%s state=%d\n"
      : "[MODEM TX] BUSY owner=%s current=%d\n",
    owner,
    static_cast<int>(
      granted
        ? requested
        : modemTxState
    )
  );

  return granted;
}

void setModemTransactionState(
  ModemTransactionState state
) {

  portENTER_CRITICAL(
    &modemTxMux
  );

  modemTxState =
    state;

  portEXIT_CRITICAL(
    &modemTxMux
  );
}

void endModemTransaction(
  const char* owner
) {

  portENTER_CRITICAL(
    &modemTxMux
  );

  modemTxState =
    MODEM_TX_IDLE;

  portEXIT_CRITICAL(
    &modemTxMux
  );

  Serial.printf(
    "[MODEM TX] UNLOCK owner=%s\n",
    owner
  );

  delay(
    400
  );
}

bool waitForModemIdle(
  uint32_t timeoutMs
) {

  const uint32_t startedAt =
    millis();

  while (
    modemTxState !=
    MODEM_TX_IDLE
  ) {

    if (
      static_cast<uint32_t>(
        millis() - startedAt
      ) >= timeoutMs
    ) {

      return false;
    }

    delay(
      20
    );
  }

  return true;
}

