}

// ==========================================
// NUEVO: HANDLERS DEL PORTAL CAUTIVO V2
// ==========================================

static esp_err_t provisioning_handler(httpd_req_t *req) {
    last_portal_activity = esp_timer_get_time();
    
    const char *error_banner = (current_portal_state == PORTAL_STATE_FAILED) ? 
        "<div style='background:#f8d7da;color:#721c24;padding:10px;border-radius:4px;margin-bottom:15px;'>⚠️ Contraseña incorrecta o red no encontrada. Intente de nuevo.</div>" : "";

    char html[2048];
    snprintf(html, sizeof(html), 
        "<!DOCTYPE html><html><head><meta name='viewport' content='width=device-width, initial-scale=1'>"
        "<title>Seguimiento 360 - Configuración</title>"
        "<style>body{font-family:system-ui,sans-serif;padding:20px;max-width:400px;margin:0 auto;} "
        "input{width:100%%;margin:8px 0;padding:10px;border:1px solid #ccc;border-radius:4px;box-sizing:border-box;} "
        "button{width:100%%;padding:12px;background:#007bff;color:white;border:none;border-radius:4px;font-size:16px;cursor:pointer;margin-top:10px;}"
        "button:hover{background:#0056b3;} hr{margin:20px 0;border:0;border-top:1px solid #eee;}</style></head>"
        "<body><h2>📡 Configuración HUB</h2>%s"
        "<form action='/save' method='POST'>"
        "<label>Red Wi-Fi (SSID):</label><input type='text' name='ssid' value='%s' required>"
        "<label>Contraseña:</label><input type='password' name='password' value='%s' required>"
        "<hr>"
        "<label>Tenant ID:</label><input type='text' name='tenant_id' value='%s' placeholder='0'>"
        "<label>Site ID:</label><input type='text' name='site_id' value='%s' placeholder='site0'>"
        "<button type='submit'>Validar y Guardar</button>"
        "</form></body></html>",
        error_banner,
        active_config.ssid, active_config.password,
        active_config.tenant_id, active_config.site_id
    );

    httpd_resp_set_type(req, "text/html");
    return httpd_resp_send(req, html, strlen(html));
}

static esp_err_t save_config_handler(httpd_req_t *req) {
    last_portal_activity = esp_timer_get_time();
    char buf[512];
    int ret = httpd_req_recv(req, buf, sizeof(buf) - 1);
    if (ret <= 0) {
        httpd_resp_send_500(req);
        return ESP_FAIL;
    }
    buf[ret] = '\0';

    char temp_ssid[33] = {0}, temp_pass[65] = {0};
    char temp_tenant[16] = "0", temp_site[32] = "site0";

    get_form_param(buf, "ssid", temp_ssid, sizeof(temp_ssid));
    get_form_param(buf, "password", temp_pass, sizeof(temp_pass));
    get_form_param(buf, "tenant_id", temp_tenant, sizeof(temp_tenant));
    get_form_param(buf, "site_id", temp_site, sizeof(temp_site));

    if (strlen(temp_ssid) == 0) {
        httpd_resp_send_err(req, HTTPD_400_BAD_REQUEST, "SSID requerido");
        return ESP_FAIL;
    }

    current_portal_state = PORTAL_STATE_TESTING;
    ESP_LOGI(TAG, "Validando conexión Wi-Fi con: %s", temp_ssid);

    // 1. Desconectar STA actual si existe
    esp_wifi_disconnect();
    vTaskDelay(pdMS_TO_TICKS(500));

    // 2. Configurar nuevas credenciales temporalmente
    wifi_config_t wifi_cfg = {0};
    memcpy(wifi_cfg.sta.ssid, temp_ssid, strlen(temp_ssid));
    memcpy(wifi_cfg.sta.password, temp_pass, strlen(temp_pass));
    esp_wifi_set_config(WIFI_IF_STA, &wifi_cfg);

    // 3. Intentar conectar y esperar hasta 15s
    xEventGroupClearBits(wifi_event_group, WIFI_CONNECTED_BIT | WIFI_FAIL_BIT);
    esp_wifi_connect();

    EventBits_t bits = xEventGroupWaitBits(wifi_event_group,
            WIFI_CONNECTED_BIT | WIFI_FAIL_BIT,
            pdFALSE, pdFALSE, pdMS_TO_TICKS(WIFI_CONNECT_TIMEOUT_MS));

    if (bits & WIFI_CONNECTED_BIT) {
        // ÉXITO: Guardar en NVS y redirigir a estado
        ESP_LOGI(TAG, "Conexión Wi-Fi exitosa. Guardando configuración multi-tenant.");
        active_config.version = 2;
        strncpy(active_config.ssid, temp_ssid, sizeof(active_config.ssid));
        strncpy(active_config.password, temp_pass, sizeof(active_config.password));
        strncpy(active_config.tenant_id, temp_tenant, sizeof(active_config.tenant_id));
        strncpy(active_config.site_id, temp_site, sizeof(active_config.site_id));
        save_config();
        
        current_portal_state = PORTAL_STATE_CONNECTED;
        start_mqtt_client(); // Iniciar MQTT con la nueva configuración

        httpd_resp_set_status(req, "303 See Other");
        httpd_resp_set_hdr(req, "Location", "/status");
        return httpd_resp_send(req, NULL, 0);
    } else {
        // FALLO: No guardar, volver al formulario con mensaje de error
        ESP_LOGW(TAG, "Fallo de conexión Wi-Fi. Volviendo al formulario.");
        current_portal_state = PORTAL_STATE_FAILED;
        
        httpd_resp_set_status(req, "303 See Other");
        httpd_resp_set_hdr(req, "Location", "/");
        return httpd_resp_send(req, NULL, 0);
    }
}

static esp_err_t status_handler(httpd_req_t *req) {
    last_portal_activity = esp_timer_get_time();
    
    if (current_portal_state != PORTAL_STATE_CONNECTED) {
        httpd_resp_set_status(req, "303 See Other");
        httpd_resp_set_hdr(req, "Location", "/");
        return httpd_resp_send(req, NULL, 0);
    }

    // Obtener IP local
    esp_netif_ip_info_t ip_info;
    char ip_str[16] = "Desconocida";
    if (esp_netif_get_ip_info(esp_netif_get_handle_from_ifkey("WIFI_STA_DEF"), &ip_info) == ESP_OK) {
        snprintf(ip_str, sizeof(ip_str), IPSTR, IP2STR(&ip_info.ip));
    }

    // Obtener conteo de nodos
    esp_now_peer_num_t peer_num;
    esp_now_get_peer_num(&peer_num);

    const char *mqtt_status_class = mqtt_is_connected ? "ok" : "err";
    const char *mqtt_status_text = mqtt_is_connected ? "✅ Conectado" : "❌ Desconectado";

    char html[2048];
    snprintf(html, sizeof(html),
        "<!DOCTYPE html><html><head><meta http-equiv='refresh' content='10'>"
        "<meta name='viewport' content='width=device-width, initial-scale=1'>"
        "<title>Seguimiento 360 - Estado</title>"
        "<style>body{font-family:system-ui,sans-serif;padding:20px;max-width:400px;margin:0 auto;} "
        ".ok{color:#28a745;} .err{color:#dc3545;} .card{background:#f8f9fa;padding:15px;border-radius:8px;margin-bottom:10px;}"
        "a.reset{display:block;text-align:center;margin-top:20px;color:#dc3545;text-decoration:none;font-weight:bold;}</style></head>"
        "<body><h2>✅ HUB Operativo</h2>"
        "<div class='card'><p>🌐 IP Local: <b>%s</b></p>"
        "<p>📡 MQTT: <b class='%s'>%s</b></p>"
        "<p>🔗 Nodos Vinculados: <b>%d / %d</b></p>"
        "<p>🏢 Tenant: <b>%s</b> | Site: <b>%s</b></p></div>"
        "<a href='/factory_reset' class='reset' onclick=\"return confirm('¿Borrar toda la configuración y reiniciar?');\">⚠️ Reconfigurar de Fábrica</a>"
        "</body></html>",
        ip_str, mqtt_status_class, mqtt_status_text,
        peer_num.total_num, MAX_ALLOWED_PEERS,
        active_config.tenant_id, active_config.site_id
    );

    httpd_resp_set_type(req, "text/html");
    return httpd_resp_send(req, html, strlen(html));
}

static esp_err_t factory_reset_handler(httpd_req_t *req) {
    ESP_LOGW(TAG, "Solicitado reinicio de fábrica. Borrando NVS...");
    nvs_erase_all(nvs_handle_pairing);
    nvs_commit(nvs_handle_pairing);
    
    httpd_resp_set_type(req, "text/html");
    httpd_resp_send(req, "<!DOCTYPE html><html><body><h3>Reiniciando...</h3><p>El portal estará disponible en 10 segundos como 'Seguimiento360_HUB'.</p></body></html>", HTTPD_RESP_USE_STRLEN);
    
    vTaskDelay(pdMS_TO_TICKS(1000));
    esp_restart();
    return ESP_OK;
}

// NUEVO: Tarea de vigilancia para cerrar el portal por inactividad
static void portal_inactivity_task(void *pvParameters) {
    while(1) {
        vTaskDelay(pdMS_TO_TICKS(5000)); // Chequear cada 5 segundos
        if (current_portal_state == PORTAL_STATE_CONNECTED && server != NULL) {
            uint64_t now = esp_timer_get_time();
            if ((now - last_portal_activity) > (PORTAL_INACTIVITY_TIMEOUT_MS * 1000ULL)) {
                ESP_LOGI(TAG, "Inactividad de %d segundos detectada. Deteniendo portal cautivo para liberar recursos.", PORTAL_INACTIVITY_TIMEOUT_MS / 1000);
                httpd_stop(server);
                server = NULL;
                vTaskDelete(NULL); // Auto-eliminar la tarea
            }
        }
    }
}

static esp_err_t start_captive_portal() {
    httpd_config_t config = HTTPD_DEFAULT_CONFIG();
    config.stack_size = 8192;
    config.max_uri_handlers = 8;
    
    if (httpd_start(&server, &config) == ESP_OK) {
        httpd_uri_t uri_config[] = {
            {.uri = "/", .method = HTTP_GET, .handler = provisioning_handler, .user_ctx = NULL},
            {.uri = "/save", .method = HTTP_POST, .handler = save_config_handler, .user_ctx = NULL},
            {.uri = "/status", .method = HTTP_GET, .handler = status_handler, .user_ctx = NULL},
            {.uri = "/factory_reset", .method = HTTP_GET, .handler = factory_reset_handler, .user_ctx = NULL}
        };
        
        for (int i = 0; i < 4; i++) {
            httpd_register_uri_handler(server, &uri_config[i]);
        }
        
        last_portal_activity = esp_timer_get_time();
        xTaskCreate(&portal_inactivity_task, "portal_watchdog", 2048, NULL, 1, NULL);
        ESP_LOGI(TAG, "Portal Cautivo v2 iniciado en http://192.168.4.1");
    }
    return ESP_OK;
}

// ==========================================
// APP MAIN
// ==========================================
void app_main(void) {
    // 1. Inicialización NVS
    esp_err_t ret = nvs_flash_init();
    if (ret == ESP_ERR_NVS_NO_FREE_PAGES || ret == ESP_ERR_NVS_NEW_VERSION_FOUND) {
        ESP_ERROR_CHECK(nvs_flash_erase());
        ret = nvs_flash_init();
    }
    ESP_ERROR_CHECK(ret);

    // 2. Cargar configuración (con migración automática si es necesario)
    load_config();

    // 3. Obtener MAC del HUB para identificación
    uint8_t mac[6];
    esp_read_mac(mac, ESP_MAC_WIFI_STA);
    snprintf(hub_mac_str, sizeof(hub_mac_str), "%02x%02x%02x%02x%02x%02x", mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);

    // 4. Inicializar Event Group
    wifi_event_group = xEventGroupCreate();

    // 5. Inicializar Red y Wi-Fi (APSTA)
    ESP_ERROR_CHECK(esp_netif_init());
    ESP_ERROR_CHECK(esp_event_loop_create_default());
    
    esp_netif_create_default_wifi_ap();
    esp_netif_create_default_wifi_sta();

    wifi_init_config_t cfg = WIFI_INIT_CONFIG_DEFAULT();
    ESP_ERROR_CHECK(esp_wifi_init(&cfg));

    // NUEVO: Anti-brownout (Preservado de tu versión probada)
    esp_wifi_set_ps(WIFI_PS_NONE);

    ESP_ERROR_CHECK(esp_event_handler_instance_register(WIFI_EVENT, ESP_EVENT_ANY_ID, &wifi_event_handler, NULL, NULL));
    ESP_ERROR_CHECK(esp_event_handler_instance_register(IP_EVENT, IP_EVENT_STA_GOT_IP, &wifi_event_handler, NULL, NULL));

    // 6. Configurar AP para Portal Cautivo
    wifi_config_t ap_config = {
        .ap = {
            .ssid = "Seguimiento360_HUB",
            .ssid_len = strlen("Seguimiento360_HUB"),
            .password = "hub_password_2026",
            .max_connection = 4,
            .authmode = WIFI_AUTH_WPA2_PSK
        },
    };
    ESP_ERROR_CHECK(esp_wifi_set_mode(WIFI_MODE_APSTA));
    ESP_ERROR_CHECK(esp_wifi_set_config(WIFI_IF_AP, &ap_config));
    
    // 7. Si hay credenciales STA guardadas, intentar conectar; si no, quedarse solo en AP
    if (strlen(active_config.ssid) > 0) {
        wifi_config_t sta_config = {0};
        memcpy(sta_config.sta.ssid, active_config.ssid, strlen(active_config.ssid));
        memcpy(sta_config.sta.password, active_config.password, strlen(active_config.password));
        ESP_ERROR_CHECK(esp_wifi_set_config(WIFI_IF_STA, &sta_config));
        ESP_ERROR_CHECK(esp_wifi_start());
        esp_wifi_connect();
        wifi_configured = true;
    } else {
        ESP_ERROR_CHECK(esp_wifi_start());
    }

    // 8. Inicializar ESP-NOW (Lógica existente preservada)
    ESP_ERROR_CHECK(esp_now_init());
    ESP_ERROR_CHECK(esp_now_register_recv_cb(on_data_recv));
    // ... (Aquí va tu configuración de peer broadcast y canal existente) ...

    // 9. Iniciar MQTT si ya estamos configurados
    if (wifi_configured) {
        start_mqtt_client();
    }

    // 10. Iniciar Portal Cautivo (Siempre disponible para reconfiguración o primer setup)
    start_captive_portal();
}
